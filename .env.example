# Copy this file to .env and fill in your key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional: change the model (default claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# FREE option: run a local model with Ollama instead of the Claude API.
# Install Ollama, pull a model that supports tools, then set:
# LLM_BASE_URL=http://localhost:11434
# CLAUDE_MODEL=qwen3        # the Ollama model name
